# High-entropy secret key (>= 32 bytes) used to encrypt secrets stored in the database.
# Generate one, e.g.: openssl rand -base64 32   (or: openssl rand -hex 32)
# The key is checked at startup: a missing or weak value stops the app.
REDFISH_SECRET_KEY=
DATABASE_URL=file:./data/redfish.db
# Audit log retention, in days (default 365).
REDFISH_AUDIT_RETENTION_DAYS=
# Public URL of the app (required by adapter-node).
ORIGIN=http://localhost:3000

# Behind a reverse proxy (production): without these variables the app sees the proxy IP
# for every client, and rate limiting (login, tracking) lumps them together: one client
# can block everyone. See docs/deployment.md.
# Header carrying the client IP: CF-Connecting-IP (Cloudflare Tunnel) or X-Forwarded-For.
# ADDRESS_HEADER=CF-Connecting-IP
# With X-Forwarded-For only: number of trusted proxies in front of the app.
# XFF_DEPTH=1

# Worker polling interval for the job queue, in milliseconds (optional).
# WORKER_INTERVAL_MS=5000

# Litestream backup (optional, compose profile "backup").
LITESTREAM_BUCKET=
LITESTREAM_PATH=redfish.db
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Host isolation (production): the operator app and the public tracking pages on two
# separate host names (with the port if not standard). Set both or neither. If both are
# empty (local development), no host restriction applies.
DASHBOARD_HOST=
TRACKING_HOST=

# First account, used only by `npm run db:seed` (pass on the command line rather than here).
# SEED_EMAIL=
# SEED_PASSWORD=
# SEED_ROLE=operator
