# Clé secrète à haute entropie (>= 32 octets) pour chiffrer les secrets en base.
# Générez-la, p. ex. : openssl rand -base64 32   (ou : openssl rand -hex 32)
# La clé est validée au démarrage : une valeur absente ou trop faible stoppe l'app.
REDFISH_SECRET_KEY=
DATABASE_URL=file:./data/redfish.db
# URL publique de l'application (requise par adapter-node).
ORIGIN=http://localhost:3000

# Behind a reverse proxy (production): without these variables the app sees the proxy IP
# for every client, and rate limiting (login, tracking) lumps them together: one client
# can block everyone. See docs/deployment.md.
# Header carrying the client IP: CF-Connecting-IP (Cloudflare Tunnel) or X-Forwarded-For.
# ADDRESS_HEADER=CF-Connecting-IP
# With X-Forwarded-For only: number of trusted proxies in front of the app.
# XFF_DEPTH=1

# Sauvegarde Litestream (optionnelle, profil compose « backup »).
LITESTREAM_BUCKET=
LITESTREAM_PATH=redfish.db
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Isolation des hôtes (production) : l'app opérateur et le tracking public sur deux
# noms d'hôte distincts (avec le port si non standard). Si l'une des deux variables
# est vide (dev local), aucune restriction d'hôte n'est appliquée.
DASHBOARD_HOST=
TRACKING_HOST=
