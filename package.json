{
	"name": "redfish",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"start": "node build",
		"build:worker": "esbuild scripts/worker.ts scripts/migrate.ts --bundle --platform=node --format=esm --target=node24 --packages=external '--alias:$lib=./src/lib' --outdir=build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "node build/migrate.js",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed:demo": "tsx scripts/seed-demo.ts",
		"worker": "tsx scripts/worker.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@fontsource/inter": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@node-rs/argon2": "2.2.2",
		"@sveltejs/adapter-node": "6.0.4",
		"better-sqlite3": "13.2.0",
		"csv-parse": "6.2.1",
		"drizzle-orm": "0.45.4",
		"mjml": "5.4.1",
		"nodemailer": "10.6.1",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/better-sqlite3": "9.6.0",
		"@types/mjml": "5.4.2",
		"@types/node": "24.19.2",
		"drizzle-kit": "0.31.11",
		"esbuild": "0.28.2",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
