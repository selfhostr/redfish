<!--
  redfish : gabarit d'e-mail d'ENTRAÎNEMENT (sensibilisation).
  Leurre simulé : décompte de prestations avec un remboursement en attente
  (assurance maladie). Aucune donnée saisie n'est lue ni stockée ; la simulation
  se termine par une page pédagogique.
  Placeholders rendus : {{firstName}}, {{clickUrl}}, {{openUrl}}.
  Aucune ressource externe / CDN, aucune police externe, aucun domaine sosie.
-->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Arial, Helvetica, sans-serif" />
			<mj-text color="#1c1c1c" font-size="15px" line-height="22px" />
		</mj-attributes>
		<mj-style>
			.muted {
				color: #6b6b6b;
				font-size: 12px;
				line-height: 18px;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#eef0f2">
		<mj-section background-color="#00594f" padding="18px 28px">
			<mj-column>
				<mj-text color="#ffffff" font-size="17px" font-weight="700">
					Groupe Mutuel | Espace Client
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="26px 28px 8px">
			<mj-column>
				<mj-text font-size="20px" font-weight="700" padding-bottom="10px" color="#00594f">
					Votre décompte de prestations 2026 est disponible
				</mj-text>
				<mj-text>Bonjour {{ firstName }},</mj-text>
				<mj-text>
					Votre décompte de prestations est désormais disponible. Un remboursement de
					<strong>CHF 248.60</strong> est en attente de versement sur votre compte.
				</mj-text>
				<mj-text>
					Nous vous invitons à consulter votre décompte dans votre Espace Client
					<strong>sous 5 jours</strong> afin de confirmer vos coordonnées de versement.
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="4px 28px 24px">
			<mj-column>
				<mj-button
					background-color="#00594f"
					color="#ffffff"
					href="{{clickUrl}}"
					border-radius="3px"
					font-size="15px"
					font-weight="700"
					inner-padding="13px 26px"
					align="left"
				>
					Consulter mon décompte
				</mj-button>
				<mj-text css-class="muted" padding-top="18px">
					Passé ce délai, le versement pourrait être retardé.
				</mj-text>
				<mj-divider border-color="#eaeaea" border-width="1px" padding="16px 0" />
				<mj-text css-class="muted">
					Message automatique, merci de ne pas y répondre.<br />
					Service des prestations
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-raw>
			<img src="{{ openUrl }}" width="1" height="1" alt="" style="display:block;border:0;" />
		</mj-raw>
	</mj-body>
</mjml>
