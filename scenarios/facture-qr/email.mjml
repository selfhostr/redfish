<!--
  redfish — gabarit d'e-mail d'ENTRAÎNEMENT (sensibilisation).
  Leurre simulé : « 2e rappel, facture QR impayée » (QR-facture suisse). Aucune
  donnée saisie n'est lue ni stockée ; la simulation se termine par une page
  pédagogique.
  Placeholders rendus en Task 2 : {{firstName}}, {{clickUrl}}, {{openUrl}}.
  Aucune ressource externe / CDN, aucune police externe, aucun domaine sosie.
-->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Arial, Helvetica, sans-serif" />
			<mj-text color="#1c1c1c" font-size="15px" line-height="22px" />
		</mj-attributes>
		<mj-style>
			.muted {
				color: #6b6b6b;
				font-size: 12px;
				line-height: 18px;
			}
			.slip th {
				text-align: left;
				color: #555;
				font-weight: 700;
				font-size: 11px;
				text-transform: uppercase;
				padding: 2px 0;
			}
			.slip td {
				font-size: 14px;
				padding: 2px 0 8px;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#eef0f2">
		<mj-section background-color="#0a3d62" padding="18px 28px">
			<mj-column>
				<mj-text color="#ffffff" font-size="17px" font-weight="700">
					Rappel de paiement — QR-facture
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="26px 28px 8px">
			<mj-column>
				<mj-text font-size="20px" font-weight="700" padding-bottom="10px" color="#b00020">
					2<sup>e</sup> rappel : votre facture reste impayée
				</mj-text>
				<mj-text>Bonjour {{ firstName }},</mj-text>
				<mj-text>
					Sauf erreur de notre part, la facture ci-dessous demeure en souffrance. Nous vous invitons
					à procéder au règlement <strong>sous 5 jours</strong> afin d'éviter des frais de rappel
					supplémentaires et l'ouverture d'une procédure.
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="0 28px 8px">
			<mj-column width="38%">
				<mj-raw>
					<!-- Section QR type « QR-facture suisse » : QR stylisé + croix suisse centrale. --> <div
					style="border:1px solid #d7dbe0;border-radius:4px;padding:10px;text-align:center;"> <svg
					width="120" height="120" viewBox="0 0 29 29" xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true" shape-rendering="crispEdges"> <rect width="29" height="29"
					fill="#ffffff" /> <path fill="#000000" d="M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM22
					0h7v7h-7zM23 1v5h5V1zM24 2h3v3h-3zM0 22h7v7H0zM1 23v5h5v-5zM2 24h3v3H2zM9 0h1v1H9zM11
					0h1v2h-1zM13 1h1v1h-1zM15 0h1v1h-1zM18 2h1v1h-1zM9 2h1v2H9zM12 3h1v1h-1zM16 2h2v1h-2zM20
					3h1v1h-1zM8 9h1v1H8zM10 9h2v1h-2zM13 8h1v2h-1zM15 9h1v1h-1zM17 8h1v1h-1zM19 9h1v1h-1zM21
					8h1v1h-1zM24 9h1v1h-1zM26 8h1v2h-1zM0 9h1v1H0zM2 10h1v1H2zM4 9h1v2H4zM6 10h1v1H6zM9
					12h1v1H9zM11 13h1v1h-1zM8 15h1v1H8zM10 16h1v1h-1zM0 13h1v1H0zM3 13h1v1H3zM5 14h1v1H5zM0
					17h1v1H0zM2 18h1v1H2zM4 17h1v1H4zM6 18h1v1H6zM24 13h1v1h-1zM26 14h1v1h-1zM22 15h1v1h-1zM20
					16h1v1h-1zM18 13h1v1h-1zM16 14h1v1h-1zM18 17h1v1h-1zM20 18h1v1h-1zM22 19h1v1h-1zM24
					17h1v1h-1zM26 18h1v1h-1zM9 20h1v1H9zM11 21h1v2h-1zM13 20h1v1h-1zM15 22h1v1h-1zM17
					20h1v1h-1zM9 24h1v1H9zM13 24h1v1h-1zM17 24h1v1h-1zM11 26h1v1h-1zM15 26h1v1h-1zM19
					23h1v1h-1zM21 24h1v2h-1zM23 23h1v1h-1zM25 24h1v1h-1zM27 26h1v1h-1zM19 27h1v1h-1z" /> <rect
					x="12" y="12" width="5" height="5" fill="#ffffff" /> <rect x="13" y="13.4" width="3"
					height="2.2" fill="#000000" /> <rect x="14" y="12.6" width="1" height="3.8" fill="#000000"
					/> </svg> <div style="font:700 11px/1.3 Arial,sans-serif;color:#555;margin-top:4px;">
					Section paiement </div> </div>
				</mj-raw>
			</mj-column>
			<mj-column width="62%">
				<mj-raw>
					<table class="slip" width="100%" cellpadding="0" cellspacing="0"
					style="font-family:Arial,sans-serif;"> <tr><th>Compte / Payable à</th></tr> <tr><td>CH##
					0000 0000 0000 0000 0<br />Service de facturation</td></tr> <tr><th>Référence</th></tr>
					<tr><td>21 00000 00000 00000 00000 07845</td></tr> <tr><th>Montant (CHF)</th></tr> <tr><td
					style="font-size:18px;font-weight:700;">247.60</td></tr> </table>
				</mj-raw>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="4px 28px 24px">
			<mj-column>
				<mj-button
					background-color="#0a3d62"
					color="#ffffff"
					href="{{clickUrl}}"
					border-radius="3px"
					font-size="15px"
					font-weight="700"
					inner-padding="13px 26px"
					align="left"
				>
					Payer la facture en ligne
				</mj-button>
				<mj-text css-class="muted" padding-top="18px">
					Si le règlement a été effectué entre-temps, ce rappel est sans objet.
				</mj-text>
				<mj-divider border-color="#eaeaea" border-width="1px" padding="16px 0" />
				<mj-text css-class="muted">
					Message automatique du service de facturation.<br />
					Horaires du service clientèle : lun–ven, 08h00–17h00
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-raw>
			<!-- Pixel d'ouverture (suivi du domaine de l'opérateur). --> <img src="{{ openUrl }}"
			width="1" height="1" alt="" style="display:block;border:0;" />
		</mj-raw>
	</mj-body>
</mjml>
