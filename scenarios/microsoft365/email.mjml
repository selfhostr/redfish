<!--
  redfish — gabarit d'e-mail d'ENTRAÎNEMENT (sensibilisation).
  Leurre simulé : « votre mot de passe expire aujourd'hui ». Aucune donnée saisie
  n'est lue ni stockée ; la simulation se termine par une page pédagogique.
  Placeholders rendus en Task 2 : {{firstName}}, {{clickUrl}}, {{openUrl}}.
  Aucune ressource externe / CDN, aucune police externe.
-->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Segoe UI, Helvetica, Arial, sans-serif" />
			<mj-text color="#1b1b1b" font-size="15px" line-height="22px" />
		</mj-attributes>
		<mj-style>
			.muted {
				color: #6b6b6b;
				font-size: 12px;
				line-height: 18px;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#f3f3f3">
		<mj-section background-color="#ffffff" padding="28px 28px 8px">
			<mj-column>
				<mj-raw>
					<!-- Marque Microsoft (SVG inline, actif d'entraînement interne autorisé). --> <div
					style="margin-bottom:20px;font:600 15px/1 'Segoe UI',Arial,sans-serif;color:#1b1b1b;">
					<svg width="20" height="20" viewBox="0 0 23 23"
					style="vertical-align:middle;margin-right:8px;" xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"> <rect x="1" y="1" width="10" height="10" fill="#F25022" /> <rect
					x="12" y="1" width="10" height="10" fill="#7FBA00" /> <rect x="1" y="12" width="10"
					height="10" fill="#00A4EF" /> <rect x="12" y="12" width="10" height="10" fill="#FFB900" />
					</svg><span style="vertical-align:middle;">Microsoft</span> </div>
				</mj-raw>
				<mj-text font-size="21px" font-weight="600" padding-bottom="12px">
					Votre mot de passe expire aujourd'hui
				</mj-text>
				<mj-text>Bonjour {{ firstName }},</mj-text>
				<mj-text>
					Nos serveurs indiquent que le mot de passe de votre compte Microsoft&nbsp;365 arrive à
					expiration <strong>aujourd'hui</strong>. Pour éviter toute interruption de votre
					messagerie, de Teams et de vos fichiers OneDrive, vous devez vérifier votre compte dès
					maintenant.
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="4px 28px 24px">
			<mj-column>
				<mj-button
					background-color="#0067b8"
					color="#ffffff"
					href="{{clickUrl}}"
					border-radius="2px"
					font-size="15px"
					font-weight="600"
					inner-padding="12px 26px"
					align="left"
				>
					Conserver mon mot de passe actuel
				</mj-button>
				<mj-text css-class="muted" padding-top="18px">
					Si vous ne confirmez pas sous 24&nbsp;heures, l'accès à votre compte sera suspendu pour
					des raisons de sécurité.
				</mj-text>
				<mj-divider border-color="#eaeaea" border-width="1px" padding="16px 0" />
				<mj-text css-class="muted">
					Ce message a été envoyé par le centre de sécurité des comptes Microsoft.<br />
					Microsoft Corporation · One Microsoft Way · Redmond, WA 98052
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-raw>
			<!-- Pixel d'ouverture (suivi du domaine de l'opérateur, pas Microsoft). --> <img src="{{
				openUrl
			}}" width="1" height="1" alt="" style="display:block;border:0;" />
		</mj-raw>
	</mj-body>
</mjml>
