<!--
  redfish - gabarit d'e-mail d'ENTRAÎNEMENT (sensibilisation).
  Leurre simulé : échec de prélèvement d'une facture télécom de novembre.
  Aucune donnée saisie n'est lue ni stockée ; la simulation se termine par une
  page pédagogique.
  Placeholders : {{firstName}}, {{clickUrl}}, {{openUrl}}.
  Aucune ressource externe / CDN, aucune police externe, aucun domaine sosie.
-->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Arial, Helvetica, sans-serif" />
			<mj-text color="#1c1c1c" font-size="15px" line-height="22px" />
		</mj-attributes>
		<mj-style>
			.muted {
				color: #6b6b6b;
				font-size: 12px;
				line-height: 18px;
			}
			.slip th {
				text-align: left;
				color: #555;
				font-weight: 700;
				font-size: 11px;
				text-transform: uppercase;
				padding: 2px 0;
			}
			.slip td {
				font-size: 14px;
				padding: 2px 0 8px;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#eef0f2">
		<mj-section background-color="#001155" padding="18px 28px">
			<mj-column>
				<mj-text color="#ffffff" font-size="18px" font-weight="700">Swisscom</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="26px 28px 8px">
			<mj-column>
				<mj-text font-size="20px" font-weight="700" padding-bottom="10px" color="#001155">
					Votre facture de novembre n'a pas pu être prélevée
				</mj-text>
				<mj-text>Bonjour {{ firstName }},</mj-text>
				<mj-text>
					Le prélèvement de votre dernière facture a été refusé par votre établissement de paiement.
					Merci de mettre à jour votre moyen de paiement <strong>sous 48 heures</strong> afin
					d'éviter la suspension de vos services.
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="0 28px 8px">
			<mj-column>
				<mj-raw>
					<table class="slip" width="100%" cellpadding="0" cellspacing="0"
					style="font-family:Arial,sans-serif;"> <tr><th>Facture</th></tr> <tr><td>Novembre,
					abonnement et services mobiles</td></tr> <tr><th>Statut</th></tr> <tr><td>Prélèvement
					refusé</td></tr> <tr><th>Montant (CHF)</th></tr> <tr><td
					style="font-size:18px;font-weight:700;">89.90</td></tr> </table>
				</mj-raw>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="4px 28px 24px">
			<mj-column>
				<mj-button
					background-color="#001155"
					color="#ffffff"
					href="{{clickUrl}}"
					border-radius="3px"
					font-size="15px"
					font-weight="700"
					inner-padding="13px 26px"
					align="left"
				>
					Mettre à jour mon moyen de paiement
				</mj-button>
				<mj-text css-class="muted" padding-top="18px">
					Si vous avez déjà régularisé votre situation, ce message est sans objet.
				</mj-text>
				<mj-divider border-color="#eaeaea" border-width="1px" padding="16px 0" />
				<mj-text css-class="muted">
					Message automatique du service de facturation.<br />
					Merci de ne pas répondre à cet e-mail.
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-raw>
			<img src="{{ openUrl }}" width="1" height="1" alt="" style="display:block;border:0;" />
		</mj-raw>
	</mj-body>
</mjml>
