<!--
  redfish — gabarit d'e-mail d'ENTRAÎNEMENT (sensibilisation).
  Leurre simulé : « remboursement d'impôt en attente » de l'administration
  cantonale valaisanne. Aucune donnée saisie n'est lue ni stockée ; la simulation
  se termine par une page pédagogique.
  Placeholders rendus en Task 2 : {{firstName}}, {{clickUrl}}, {{openUrl}}.
  Aucune ressource externe / CDN, aucune police externe, aucun domaine sosie.
-->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Arial, Helvetica, sans-serif" />
			<mj-text color="#1c1c1c" font-size="15px" line-height="22px" />
		</mj-attributes>
		<mj-style>
			.muted {
				color: #6b6b6b;
				font-size: 12px;
				line-height: 18px;
			}
			.ref {
				color: #6b6b6b;
				font-size: 13px;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#f0f0ef">
		<mj-section background-color="#e30613" padding="18px 28px">
			<mj-column>
				<mj-raw>
					<!-- Armoiries stylisées du Valais (SVG inline, rouge/blanc, 13 étoiles). --> <div
					style="font:700 16px/1.2 Arial,sans-serif;color:#ffffff;"> <svg width="22" height="26"
					viewBox="0 0 22 26" style="vertical-align:middle;margin-right:10px;"
					xmlns="http://www.w3.org/2000/svg" aria-hidden="true"> <path d="M1 1h20v15c0 5-4 7-10
					9-6-2-10-4-10-9z" fill="#ffffff" stroke="#ffffff" /> <path d="M11 1v15.5M1 9h20"
					stroke="#e30613" stroke-width="2" /> <g fill="#e30613"><circle cx="5" cy="4"
					r="1"/><circle cx="11" cy="4" r="1"/><circle cx="17" cy="4" r="1"/><circle cx="5" cy="13"
					r="1"/><circle cx="11" cy="13" r="1"/><circle cx="17" cy="13" r="1"/></g> </svg><span
					style="vertical-align:middle;">État du Valais · Service cantonal des contributions</span>
					</div>
				</mj-raw>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="28px 28px 8px">
			<mj-column>
				<mj-text font-size="20px" font-weight="700" padding-bottom="12px">
					Votre décompte d'impôt 2025 fait apparaître un trop-perçu
				</mj-text>
				<mj-text>Madame, Monsieur {{ firstName }},</mj-text>
				<mj-text>
					Après vérification de votre dossier fiscal, le traitement de votre déclaration fait
					ressortir un <strong>trop-perçu de CHF&nbsp;348.20</strong> en votre faveur. Afin de
					procéder au virement, nous devons confirmer les coordonnées de votre espace fiscal
					sécurisé.
				</mj-text>
				<mj-text css-class="ref">
					Référence du dossier : VS-2025-{{ firstName }} · Caisse : Sion
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section background-color="#ffffff" padding="4px 28px 24px">
			<mj-column>
				<mj-button
					background-color="#e30613"
					color="#ffffff"
					href="{{clickUrl}}"
					border-radius="3px"
					font-size="15px"
					font-weight="700"
					inner-padding="13px 26px"
					align="left"
				>
					Confirmer et recevoir mon remboursement
				</mj-button>
				<mj-text css-class="muted" padding-top="18px">
					Sans confirmation de votre part sous 5&nbsp;jours ouvrables, le remboursement sera annulé
					et le montant reporté sur l'exercice suivant.
				</mj-text>
				<mj-divider border-color="#eaeaea" border-width="1px" padding="16px 0" />
				<mj-text css-class="muted">
					Ce message est émis par l'espace e-démarches de l'administration cantonale.<br />
					Service cantonal des contributions · Avenue de la Gare 35 · 1951 Sion
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-raw>
			<!-- Pixel d'ouverture (suivi du domaine de l'opérateur, pas l'État du Valais). --> <img
			src="{{ openUrl }}" width="1" height="1" alt="" style="display:block;border:0;" />
		</mj-raw>
	</mj-body>
</mjml>
